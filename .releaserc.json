{
  "branches": [
    "main",
    {
      "name": "beta",
      "prerelease": true
    },
    {
      "name": "alpha",
      "prerelease": true
    }
  ],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          {
            "type": "feat",
            "release": "minor"
          },
          {
            "type": "fix",
            "release": "patch"
          },
          {
            "type": "perf",
            "release": "patch"
          },
          {
            "type": "revert",
            "release": "patch"
          },
          {
            "type": "docs",
            "release": false
          },
          {
            "type": "style",
            "release": false
          },
          {
            "type": "chore",
            "release": false
          },
          {
            "type": "refactor",
            "release": "patch"
          },
          {
            "type": "test",
            "release": false
          },
          {
            "type": "build",
            "release": false
          },
          {
            "type": "ci",
            "release": false
          },
          {
            "scope": "no-release",
            "release": false
          }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            {
              "type": "feat",
              "section": "✨ Novas Funcionalidades"
            },
            {
              "type": "fix",
              "section": "🐛 Correções de Bugs"
            },
            {
              "type": "perf",
              "section": "⚡ Melhorias de Performance"
            },
            {
              "type": "revert",
              "section": "⏪ Reversões"
            },
            {
              "type": "docs",
              "section": "📚 Documentação",
              "hidden": false
            },
            {
              "type": "style",
              "section": "💅 Estilo",
              "hidden": true
            },
            {
              "type": "chore",
              "section": "🔧 Tarefas",
              "hidden": true
            },
            {
              "type": "refactor",
              "section": "♻️ Refatorações"
            },
            {
              "type": "test",
              "section": "✅ Testes",
              "hidden": true
            },
            {
              "type": "build",
              "section": "📦 Build",
              "hidden": true
            },
            {
              "type": "ci",
              "section": "👷 CI/CD",
              "hidden": true
            }
          ]
        },
        "writerOpts": {
          "commitPartial": "* {{#if scope}}**{{scope}}:** {{/if}}{{subject}} ({{hash}})\n"
        }
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# Changelog\n\nTodas as mudanças notáveis neste projeto serão documentadas neste arquivo.\n\nO formato é baseado em [Keep a Changelog](https://keepachangelog.com/pt-BR/1.0.0/),\ne este projeto adere ao [Versionamento Semântico](https://semver.org/lang/pt-BR/)."
      }
    ],
    [
      "@semantic-release/npm",
      {
        "npmPublish": false
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "package.json",
          "package-lock.json"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "successComment": "🎉 Esta issue foi incluída na versão [${nextRelease.version}](${releases[0].url}) 🎉",
        "labels": ["released"],
        "releasedLabels": ["released<%= nextRelease.channel ? `@${nextRelease.channel}` : \"\" %>"],
        "addReleases": "bottom",
        "releaseBodyTemplate": "{{> header}}\n\n{{> commits}}\n\n{{> footer}}\n\n---\n\n## 🔗 Links\n\n- **Docker Hub**: https://hub.docker.com/r/${process.env.DOCKERHUB_USERNAME}/manager-zuckzapgo/tags\n- **GitHub Actions**: https://github.com/${process.env.GITHUB_REPOSITORY}/actions\n- **Changelog**: https://github.com/${process.env.GITHUB_REPOSITORY}/blob/main/CHANGELOG.md"
      }
    ]
  ]
}
